{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Hub",
  "version": "0.6.2",
  "identifier": "com.arno.agentic-hub",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Agentic Hub",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": { "red": 14, "green": 15, "blue": 19, "alpha": 255 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
